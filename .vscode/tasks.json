{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite: dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "beginsPattern": "VITE v", "endsPattern": "Local:" }
      }
    },
    {
      "label": "vite: build + preview",
      "type": "shell",
      "command": "npm run build && npm run preview -- --port 4173 --strictPort",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^(.*)\\((\\d+),(\\d+)\\): error (TS\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "code": 4, "message": 5 },
        "background": { "beginsPattern": "tsc --noEmit", "endsPattern": "Local:" }
      }
    }
  ]
}
