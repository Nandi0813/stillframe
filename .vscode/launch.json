{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev server (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "vite: dev"
    },
    {
      "name": "Production build (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4173",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": { "../src/*": "${workspaceFolder}/src/*" },
      "preLaunchTask": "vite: build + preview"
    }
  ]
}
